<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="24dp">

    <!-- Left side: Welcome message -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo_rect"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:text="@string/welcome_to_my_lens"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/preview_button"
                android:layout_width="150dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:gravity="center"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="@string/open_camera_preview_land"
                android:background="@drawable/rounded_button"
                android:textColor="#000"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/visit_website_button"
                android:layout_width="150dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:gravity="center"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="@string/visit_website_land"
                android:background="@drawable/rounded_button"
                android:textColor="#000"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/select_storage_button"
                android:layout_width="150dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:gravity="center"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="@string/select_storage_location"
                android:background="@drawable/rounded_button"
                android:textColor="#000"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/privacy_policy_button"
                android:layout_width="150dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:gravity="center"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:text="@string/privacy_policy_land"
                android:background="@drawable/rounded_button"
                android:textColor="#000"
                android:textAllCaps="false" />

        </GridLayout>

    </FrameLayout>
</LinearLayout>
